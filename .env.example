# Database Configuration (Local Development)
DATABASE_URL=postgresql+asyncpg://straumann:password@localhost:5432/straumann_event_db
DATABASE_URL_SYNC=postgresql://straumann:password@localhost:5432/straumann_event_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
PROJECT_NAME=STRAUMANN Event API
VERSION=1.0.0
DEBUG=True
API_V1_STR=/api/v1

# CORS Configuration (Allow frontend development servers)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:8080", "http://localhost:19006"]

# File Upload Configuration
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "gif", "webp"]

# Email Configuration (for notifications) - Optional for development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@straumann-event.com

# Push Notifications (Firebase) - Optional for development
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# AWS S3 Configuration - Optional for development
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=straumann-event-files
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30 